NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/DreamlineSalesBot?retryWrites=true&w=majority

# ──────────────────────────────────────────────────────────────────────
# SUPER ADMIN KEY — generate with: npm run gen-key
# ──────────────────────────────────────────────────────────────────────
SUPER_ADMIN_API_KEY=your_super_admin_key_here

# ──────────────────────────────────────────────────────────────────────
# META WHATSAPP CLOUD API
# ──────────────────────────────────────────────────────────────────────
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_REDIRECT_URI=https://your-domain.com/onboarding/callback
META_WEBHOOK_VERIFY_TOKEN=your_verify_token_here
META_WHATSAPP_TOKEN=your_long_lived_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_API_VERSION=v21.0
WA_API_VERSION=v21.0

BASE_URL=https://your-domain.com
# Optional: redirect here after Meta Embedded Signup completes
# FRONTEND_URL=https://your-frontend-domain.com/dashboard

# ──────────────────────────────────────────────────────────────────────
# GROQ AI — REQUIRED in production for full AI functionality
# Get FREE key: https://console.groq.com
# ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

LOG_LEVEL=info
CORS_ORIGIN=https://your-frontend-domain.com
DISABLE_WORKING_HOURS=false

# ──────────────────────────────────────────────────────────────────────
# ADMIN PAYMENT APPROVERS (WhatsApp-only approval flow)
# Comma-separated E.164 phone numbers WITHOUT the leading +
# These admins receive payment proof screenshots + Approve/Reject buttons
# Example: ADMIN_PHONES=2207123456,2207654321
# ──────────────────────────────────────────────────────────────────────
ADMIN_PHONES=

# ──────────────────────────────────────────────────────────────────────
# API KEY MIGRATION
# Run `npm run migrate-apikey` ONCE after first deployment, then set this
# to true to disable the plaintext API key fallback path.
# ──────────────────────────────────────────────────────────────────────
APIKEY_MIGRATION_DONE=true


# ── Cloudinary (OPTIONAL — required only for menu image uploads) ──────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
