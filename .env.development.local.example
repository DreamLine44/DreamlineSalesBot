NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/WhatsBotLyn_v5?replicaSet=rs0

# ──────────────────────────────────────────────────────────────────────
# SUPER ADMIN KEY — only YOU use this to manage tenants
# Generate a fresh one: npm run gen-key
# ──────────────────────────────────────────────────────────────────────
SUPER_ADMIN_API_KEY=your_super_admin_key_here

# ──────────────────────────────────────────────────────────────────────
# META WHATSAPP CLOUD API
# In multi-tenant mode these are stored per-tenant in the database.
# These are used as fallback for single-tenant / dev setups only.
# Get from: https://developers.facebook.com → Your App → WhatsApp → API Setup
# ──────────────────────────────────────────────────────────────────────
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET
META_REDIRECT_URI=http://localhost:5000/onboarding/callback
META_WEBHOOK_VERIFY_TOKEN=your_verify_token_here
META_WHATSAPP_TOKEN=your_whatsapp_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_API_VERSION=v21.0
WA_API_VERSION=v21.0

# Base URL (used in onboarding to show your webhook URL)
BASE_URL=https://your-ngrok-url.ngrok.io

# ──────────────────────────────────────────────────────────────────────
# GROQ AI — free inference layer (REQUIRED for smart AI replies)
# Powers: fallback responses, about-questions, greetings, repeat handling.
# Get your FREE key at: https://console.groq.com (no credit card needed)
#
# Model cascade (automatic):
#   1st: llama-3.1-8b-instant   → ultra-fast, 131k ctx, free tier
#   2nd: llama-3.3-70b-versatile → more accurate, used only if 1st fails
#
# The bot will run without this key but AI replies will fall back to a
# static "Type Order / Book" message. Set this key for full AI power.
# ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ──────────────────────────────────────────────────────────────────────
# PAYMENT (Wave mobile money — Gambia)
# Set per-tenant via /business API. These are global defaults for dev.
# ──────────────────────────────────────────────────────────────────────
# WAVE_PHONE=+220XXXXXXX
# PAYMENT_CURRENCY=GMD

LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000,http://localhost:5000
DISABLE_WORKING_HOURS=true

# ──────────────────────────────────────────────────────────────────────
# ADMIN PAYMENT APPROVERS (WhatsApp-only approval flow)
# Comma-separated E.164 phone numbers WITHOUT the leading +
# These admins receive payment proof screenshots + Approve/Reject buttons
# Example: ADMIN_PHONES=2207123456,2207654321
# ──────────────────────────────────────────────────────────────────────
ADMIN_PHONES=
