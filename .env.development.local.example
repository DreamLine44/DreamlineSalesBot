NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/DreamlineSalesBot?replicaSet=rs0

# ──────────────────────────────────────────────────────────────────────
# SUPER ADMIN KEY — only YOU use this to manage tenants
# Generate a fresh one: npm run gen-key
# ──────────────────────────────────────────────────────────────────────
SUPER_ADMIN_API_KEY=your_super_admin_key_here

# ──────────────────────────────────────────────────────────────────────
# META WHATSAPP CLOUD API
# In multi-tenant mode these are stored per-tenant in the database.
# These are used as fallback for single-tenant / dev setups only.
# Get from: https://developers.facebook.com → Your App → WhatsApp → API Setup
# ──────────────────────────────────────────────────────────────────────
# !! IMPORTANT: Use the App ID from developers.facebook.com → My Apps
# Your app is: Sales Agent Bot (ID: 1221180509938842)
# Get App Secret from: App Settings → Basic → App Secret
META_APP_ID=YOUR_META_APP_ID
META_APP_SECRET=YOUR_META_APP_SECRET

# OAuth redirect URI — used ONLY for Embedded Signup (NOT the webhook URL)
# Webhook URL is: <BASE_URL>/webhook  ← set this in Meta dashboard → Configuration
META_REDIRECT_URI=http://localhost:5000/onboarding/callback
META_WEBHOOK_VERIFY_TOKEN=your_verify_token_here
META_WHATSAPP_TOKEN=your_whatsapp_access_token_here
META_PHONE_NUMBER_ID=your_phone_number_id_here
META_API_VERSION=v21.0
WA_API_VERSION=v21.0

# Base URL (used in onboarding to show your webhook URL)
BASE_URL=https://your-ngrok-url.ngrok.io
# Optional: redirect here after Meta Embedded Signup completes
# FRONTEND_URL=http://localhost:3000/dashboard

# ──────────────────────────────────────────────────────────────────────
# GROQ AI — free inference layer (REQUIRED for smart AI replies)
# Powers: fallback responses, about-questions, greetings, repeat handling.
# Get your FREE key at: https://console.groq.com (no credit card needed)
#
# Model cascade (automatic):
#   1st: llama-3.1-8b-instant   → ultra-fast, 131k ctx, free tier
#   2nd: llama-3.3-70b-versatile → more accurate, used only if 1st fails
#
# The bot will run without this key but AI replies will fall back to a
# static "Type Order / Book" message. Set this key for full AI power.
# ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ──────────────────────────────────────────────────────────────────────
# PAYMENT (Wave mobile money — Gambia)
# Set per-tenant via /business API. These are global defaults for dev.
# ──────────────────────────────────────────────────────────────────────
# WAVE_PHONE=+220XXXXXXX
# PAYMENT_CURRENCY=GMD

LOG_LEVEL=debug
CORS_ORIGIN=http://localhost:3000,http://localhost:5000
DISABLE_WORKING_HOURS=true

# ──────────────────────────────────────────────────────────────────────
# ADMIN PAYMENT APPROVERS (WhatsApp-only approval flow)
# Comma-separated E.164 phone numbers WITHOUT the leading +
# These admins receive payment proof screenshots + Approve/Reject buttons
# Example: ADMIN_PHONES=2207123456,2207654321
# ──────────────────────────────────────────────────────────────────────
ADMIN_PHONES=


# ── Cloudinary (OPTIONAL — required only for menu image uploads) ──────────────
# Sign up free at https://cloudinary.com — images are served via CDN to WhatsApp
# Leave blank to disable image uploads (bot works fine without them)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ──────────────────────────────────────────────────────────────────────
# DEV ONLY: Skip webhook HMAC signature check so you can test with
# curl/Bruno/Postman without computing signatures manually.
# Set to "true" only in development. NEVER in production.
# ──────────────────────────────────────────────────────────────────────
SKIP_WEBHOOK_SIGNATURE=true
APIKEY_MIGRATION_DONE=true

# ──────────────────────────────────────────────────────────────────────
# TOKEN ENCRYPTION (AES-256-GCM)
# Generate with: npm run gen-key
# When set, WhatsApp access tokens are encrypted at rest in MongoDB.
# If not set, tokens are stored as plain text (acceptable for dev/test).
# REQUIRED in production to protect tenant WhatsApp credentials.
# ──────────────────────────────────────────────────────────────────────
ENCRYPTION_KEY=

# ──────────────────────────────────────────────────────────────────────
# SESSION TUNING
# SESSION_TTL_MINUTES     — idle session timeout (default: 30)
# PAYMENT_SESSION_TTL_HOURS — TTL extension when customer is in payment
#                             proof step (Wave payment can take time)
#                             (default: 4)
# PROOF_ELIGIBLE_HOURS    — how long after an order the bot still accepts
#                           a new proof upload (default: 48)
# ──────────────────────────────────────────────────────────────────────
SESSION_TTL_MINUTES=30
PAYMENT_SESSION_TTL_HOURS=4
PROOF_ELIGIBLE_HOURS=48

# ──────────────────────────────────────────────────────────────────────
# SCHEDULER
# Set to "false" to disable the background job that sends payment and
# booking reminders via WhatsApp templates. Disable in dev to avoid
# sending accidental messages.
# ──────────────────────────────────────────────────────────────────────
SCHEDULER_ENABLED=false

# ──────────────────────────────────────────────────────────────────────
# WHATSAPP TEMPLATE LANGUAGE
# Language code used when sending approved WhatsApp message templates.
# Common values: en_US, en_GB, fr, ar
# (default: en_US)
# ──────────────────────────────────────────────────────────────────────
TEMPLATE_LANGUAGE=en_US

# Optional: URL of your frontend dashboard (used in admin email links)
# FRONTEND_URL=http://localhost:3000/dashboard
