# ══════════════════════════════════════════════════════════════════════════════
#  WhatSalesAgent2 — Environment Configuration
#
#  QUICK SETUP:
#    cp .env.example .env   (then fill in your values)
#
#  RAILWAY DEPLOYMENT:
#    Set these in Railway dashboard → Variables tab.
#    MINIMUM required to start: MONGODB_URI + SUPER_ADMIN_API_KEY
#    Everything else is optional (features degrade gracefully).
#
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ─────────────────────────────────────────────────────────────────────
NODE_ENV=development          # production | development
PORT=5000                     # Railway overrides this automatically

# ── Database ───────────────────────────────────────────────────────────────────
# REQUIRED — bot cannot start without this
MONGODB_URI=mongodb://127.0.0.1:27017/whatsalesagent2
# Atlas: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/whatsalesagent2?retryWrites=true&w=majority

# ── Security ───────────────────────────────────────────────────────────────────
# REQUIRED — generate with: npm run gen-key
SUPER_ADMIN_API_KEY=

# OPTIONAL — enables at-rest encryption for sensitive fields (must be exactly 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
ENCRYPTION_KEY=

# ── AI (optional — mock AI used when not set) ──────────────────────────────────
# Free: https://console.groq.com → Create API Key
GROQ_API_KEY=

# ── Meta / WhatsApp Cloud API ──────────────────────────────────────────────────
# From: https://developers.facebook.com → Your App → WhatsApp → API Setup
META_APP_ID=
META_APP_SECRET=
META_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
META_WABA_ID=
META_API_VERSION=v22.0

# Webhook verify token — make up any string, enter same value in Meta dashboard
META_WEBHOOK_VERIFY_TOKEN=

# ── Simulation (local dev only) ────────────────────────────────────────────────
# true = enables POST /api/message for local testing (disabled in production)
SIMULATION_MODE=false

# ── URLs ───────────────────────────────────────────────────────────────────────
BASE_URL=https://YOUR_DOMAIN.railway.app
CORS_ORIGIN=https://YOUR_FRONTEND_DOMAIN.com

# ── Admin phones ───────────────────────────────────────────────────────────────
# Comma-separated WhatsApp numbers (no +) that can send APPROVE/REJECT/CONFIRM BOOK
ADMIN_PHONES=

# ── Scheduler ──────────────────────────────────────────────────────────────────
# Enables: abandoned cart reminders, booking reminders, payment reminders
SCHEDULER_ENABLED=true

# ── Payments ───────────────────────────────────────────────────────────────────
PROOF_ELIGIBLE_HOURS=4

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info                # debug | info | warn | error

# ── Session TTL ────────────────────────────────────────────────────────────────
SESSION_TTL_MINUTES=30
PAYMENT_SESSION_TTL_HOURS=4

# ── Working Hours ──────────────────────────────────────────────────────────────
DISABLE_WORKING_HOURS=false   # true = bot responds 24/7 regardless of configured hours

# ── WhatsApp Templates ─────────────────────────────────────────────────────────
TEMPLATE_LANGUAGE=en
TEMPLATE_NAME_ABANDONED_CART=abandoned_cart_reminder
TEMPLATE_NAME_BOOKING_REMINDER=booking_reminder
TEMPLATE_NAME_ORDER_CONFIRMED=order_confirmed
TEMPLATE_NAME_PAYMENT_REMINDER=payment_reminder
