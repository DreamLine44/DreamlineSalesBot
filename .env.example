# ─────────────────────────────────────────────────────────────
# WhatSales Backend — Environment Variables
# Copy to .env and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Core ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/whatsales

# ── Auth ──────────────────────────────────────────────────────
# Generate with: npm run genKey
SUPER_ADMIN_API_KEY=your_64_char_hex_key_here
ENCRYPTION_KEY=your_32_char_key_here

# ── Meta / WhatsApp ───────────────────────────────────────────
META_APP_SECRET=your_meta_app_secret
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
META_API_VERSION=v21.0
# Published WhatsApp Flow ID for booking date calendar picker (Option B).
# Create/publish via Meta Business Manager → WhatsApp → Flows, or: npm run publish:booking-date-flow
BOOKING_DATE_FLOW_ID=
# Set to true while testing an unpublished (draft) flow
BOOKING_DATE_FLOW_DRAFT=false
# Set to false to skip automatic Flow publishing on server startup
BOOKING_DATE_FLOW_AUTO_PROVISION=true
# Comma-separated list of phone numbers that have admin rights
ADMIN_PHONES=2201234567,2207654321

# ── AI Provider ───────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key

# ── CORS ──────────────────────────────────────────────────────
# Comma-separated allowed origins (production)
CORS_ORIGIN=https://your-dashboard.vercel.app

# ── Cloudinary (optional — for menu item images) ──────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Optional: if your Cloudinary account uses a signed upload preset
CLOUDINARY_UPLOAD_PRESET=

# ── Scheduler (optional) ─────────────────────────────────────
SCHEDULER_ENABLED=false
# Required in production if SCHEDULER_ENABLED=true:
WHATSAPP_TEMPLATES_ENABLED=false
TEMPLATE_ABANDONED_CART=abandoned_cart_reminder
TEMPLATE_BOOKING_REMINDER=booking_reminder
TEMPLATE_PAYMENT_REMINDER=payment_reminder

# ── Session TTLs (optional — defaults shown) ─────────────────
SESSION_TTL_MINUTES=30
PAYMENT_SESSION_TTL_HOURS=4
HUMAN_MODE_SESSION_TTL_HOURS=24

# ── Dev / Testing only ────────────────────────────────────────
SIMULATION_MODE=false
DISABLE_WORKING_HOURS=false
LOG_LEVEL=info
