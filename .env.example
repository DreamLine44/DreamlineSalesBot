# ─── Copy this to .env.development.local (or .env.production.local) and fill in values.
# ─── For full documentation see .env.development.local.example

# ─── MongoDB ───────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/DreamlineSalesBot

# ─── Super Admin ───────────────────────────────────────────────────────────────
SUPER_ADMIN_API_KEY=change_me

# ─── Meta / WhatsApp Cloud API ─────────────────────────────────────────────────
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_REDIRECT_URI=https://yourdomain.com/onboarding/callback
META_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
META_WHATSAPP_TOKEN=your_whatsapp_access_token
META_PHONE_NUMBER_ID=your_phone_number_id
META_API_VERSION=v21.0

# ─── Groq AI ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key

# ─── Cloudinary (image uploads) ────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ─── Token encryption (AES-256-GCM) — generate with: npm run gen-key ──────────
ENCRYPTION_KEY=your_32_byte_hex_key

# ─── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
LOG_LEVEL=info
BASE_URL=http://localhost:3000
