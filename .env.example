# ═══════════════════════════════════════════════════════════════════════════
# DreamLine SalesBot — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════
# COPY THIS FILE: cp .env.example .env.development.local
# Then fill in your real values below.
# NEVER commit .env.*.local files to git — they are gitignored by default.
# ═══════════════════════════════════════════════════════════════════════════

# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Your deployed URL — used for CORS origin auto-allow and admin links.
# Examples: https://mybot.railway.app  |  https://mybot.onrender.com
BASE_URL=https://your-deployment-url.com

# Comma-separated list of allowed CORS origins (browser clients only).
# Include your dashboard/admin UI origin here.
# Examples: https://admin.mybot.com,https://dashboard.mybot.com
# If left blank, only server-to-server (no Origin header) requests will pass.
CORS_ORIGIN=https://your-dashboard-url.com

# ─── Security Keys (auto-generated by `npm run setup`) ────────────────────────
# SUPER_ADMIN_API_KEY — protects /admin/tenants and /platform routes.
# Generate: node -e "require('crypto').randomBytes(32).toString('hex')|console.log"
SUPER_ADMIN_API_KEY=your_super_admin_key_here

# ENCRYPTION_KEY — AES-256-GCM key for WhatsApp access token storage.
# MUST be exactly 64 hex characters (32 bytes).
# Generate: node -e "require('crypto').randomBytes(32).toString('hex')|console.log"
ENCRYPTION_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
# Local MongoDB:   mongodb://localhost:27017/dreamline_bot
# MongoDB Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/dreamline_bot
MONGODB_URI=mongodb://localhost:27017/dreamline_bot

# ─── AI Providers ─────────────────────────────────────────────────────────────
# At least one of OpenAI or Groq is required for intelligent replies.
# If both are set, OpenAI is used as primary and Groq as automatic fallback.
# If neither is set, the bot uses deterministic replies only.

# OpenAI (Primary — recommended, gpt-4o-mini is fast and cheap)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=300
OPENAI_TIMEOUT_MS=8000

# Groq (Fallback — free tier available)
# Get key: https://console.groq.com
GROQ_API_KEY=gsk_your-groq-key-here

# ─── Meta / WhatsApp Cloud API ────────────────────────────────────────────────
# Leave all of these BLANK during local development (Phases 1–4).
# Fill in ONLY when connecting to Meta in Phase 5.
# See: https://developers.facebook.com/apps/
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_TOKEN=
META_PHONE_NUMBER_ID=
META_API_VERSION=v21.0

# ─── Local Simulation (Development Only) ──────────────────────────────────────
# Enables POST /api/messages for local testing without Meta.
# Auto-generated by setup wizard. Set SIMULATION_MODE=false in production.
SIMULATION_MODE=true
SIMULATION_SECRET=sim_dev_key_change_in_production

# ─── Cloudinary (Optional — for menu item image uploads) ──────────────────────
# Get credentials: https://cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: error | warn | info | debug
# Production: info   Development: debug
LOG_LEVEL=debug

# ─── Session ──────────────────────────────────────────────────────────────────
# Standard conversation timeout in minutes (default: 30)
SESSION_TTL_MINUTES=30

# Payment proof session timeout in hours (default: 4)
# Wave payments in West Africa can take 30–90 min, so keep this high.
PAYMENT_SESSION_TTL_HOURS=4

# ─── Scheduler ────────────────────────────────────────────────────────────────
# Set to true to enable background jobs:
#   - Abandoned cart recovery (every 15 min)
#   - Booking reminders       (every 60 min)
#   - Payment proof reminders (every 20 min)
# Leave false in development unless you have a live WhatsApp connection,
# otherwise the jobs will attempt real message sends on every run.
SCHEDULER_ENABLED=false

# ─── Admin Phones ─────────────────────────────────────────────────────────────
# Comma-separated E.164 phone numbers (without leading +) permitted to send
# admin commands via WhatsApp:
#   APPROVE / REJECT <shortId>       — approve or reject a payment proof
#   CONFIRM BOOK / DECLINE BOOK <id> — confirm or decline a booking
#   RESUME BOT <phone>               — exit human-handoff mode for a customer
# These are global admins across ALL tenants.
# Per-tenant adminPhone is set separately via the dashboard BusinessConfig.
# Example: ADMIN_PHONES=2207123456,2207654321
ADMIN_PHONES=

# ─── Migration Flags ──────────────────────────────────────────────────────────
# Set to true after running: npm run migrate-apikey
# Disables plaintext API key fallback once all keys are hashed.
APIKEY_MIGRATION_DONE=false

# ─── Development Helpers ──────────────────────────────────────────────────────
# Skip Meta webhook signature check locally (NEVER enable in production)
# SKIP_WEBHOOK_SIGNATURE=true
