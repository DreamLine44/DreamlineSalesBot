# ══════════════════════════════════════════════════════════════
#  WhatSalesAgent2 — Environment Configuration Template
#
#  SETUP:
#    Windows:   copy .env.example .env
#    Mac/Linux: cp .env.example .env
#
#  Then fill in your values below.
#  NEVER commit .env to version control — it is in .gitignore.
# ══════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────
# development | production
NODE_ENV=development
PORT=5000

# ── Database ──────────────────────────────────────────────────
# Local MongoDB (dev):
MONGODB_URI=mongodb://127.0.0.1:27017/whatsalesagent2
# MongoDB Atlas (production — recommended):
# MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASS@cluster0.XXXXX.mongodb.net/whatsalesagent2

# ── Security ──────────────────────────────────────────────────
# Generate both with:  npm run gen-key
SUPER_ADMIN_API_KEY=
ENCRYPTION_KEY=

# ── AI Provider ───────────────────────────────────────────────
# Free Groq inference: https://console.groq.com
# Leave blank to use built-in mock AI (works without any key)
GROQ_API_KEY=

# ── Meta / WhatsApp Cloud API ─────────────────────────────────
# From: https://developers.facebook.com → Your App → Settings → Basic
META_APP_ID=
META_APP_SECRET=

# From: Meta App Dashboard → WhatsApp → API Setup
META_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
META_WABA_ID=
META_API_VERSION=v22.0

# Webhook verification token — make up any string, must match what you enter in Meta dashboard
META_WEBHOOK_VERIFY_TOKEN=

# Redirect URI used for Meta Embedded Signup (onboarding flow)
META_REDIRECT_URI=https://YOUR_KOYEB_URL/onboarding/callback

# ── Simulation Mode ───────────────────────────────────────────
# true  = local testing, no Meta needed, enables POST /api/message
# false = live Meta webhook (required for production)
SIMULATION_MODE=false

# ── Base URL ──────────────────────────────────────────────────
# Your public deployment URL (used in onboarding links)
BASE_URL=https://YOUR_KOYEB_URL

# ── Admin Phones ──────────────────────────────────────────────
# Comma-separated phone numbers (without +) that can send admin commands
# e.g. APPROVE/REJECT/CONFIRM BOOK/RESUME BOT
ADMIN_PHONES=

# ── Scheduler ─────────────────────────────────────────────────
# Enables background jobs: abandoned cart, booking & payment reminders
# Requires live WhatsApp credentials (SIMULATION_MODE=false)
SCHEDULER_ENABLED=true

# ── Payments ──────────────────────────────────────────────────
PROOF_ELIGIBLE_HOURS=4

# ── WhatsApp Message Templates ────────────────────────────────
# Template names must EXACTLY match your approved Meta template names.
# Approve at: Meta Business Manager → WhatsApp → Message Templates
TEMPLATE_LANGUAGE=en
TEMPLATE_NAME_ABANDONED_CART=abandoned_cart_reminder
TEMPLATE_NAME_BOOKING_REMINDER=booking_reminder
TEMPLATE_NAME_ORDER_CONFIRMED=order_confirmed
TEMPLATE_NAME_PAYMENT_REMINDER=payment_reminder

# ── Logging ───────────────────────────────────────────────────
# debug = verbose (dev), info = clean (production)
LOG_LEVEL=info

# ── CORS ──────────────────────────────────────────────────────
# Your frontend/dashboard domain. Leave blank in dev.
CORS_ORIGIN=

# ── Working Hours ─────────────────────────────────────────────
# true = bot responds 24/7, ignores configured business hours
DISABLE_WORKING_HOURS=false

# ── Session TTL ───────────────────────────────────────────────
SESSION_TTL_MINUTES=30
PAYMENT_SESSION_TTL_HOURS=4
