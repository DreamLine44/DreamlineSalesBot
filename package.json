{
  "name": "dreamlinesalesbot",
  "version": "15.0.0",
  "description": "Multi-tenant WhatsApp Business SaaS Platform — v15.0.0 (Final merge: v14 + v15 fixes — token encryption, auto-usage-reset, tenant-scoped leads, analytics tenantId, UTC scheduler, fuzzy number parsing, menu ack, process crash guards)",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "seed": "node seed.js",
    "gen-key": "node --input-type=module -e \"import {randomBytes} from 'crypto'; console.log(randomBytes(32).toString('hex'))\"",
    "fix-orders": "node scripts/fix-order-index.js",
    "fix-phonenumber-index": "node scripts/fix-phonenumberid-index.js",
    "migrate-apikey": "node scripts/migrate-apikey-hash.js",
    "migrate-shortid": "node scripts/migrate-order-shortid.js",
    "migrate-encrypt-tokens": "node scripts/migrate-encrypt-tokens.js"
  },
  "dependencies": {
    "axios": "^1.15.1",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.1.5",
    "fast-levenshtein": "^3.0.0",
    "helmet": "^7.1.0",
    "json2csv": "^5.0.7",
    "mongoose": "^8.23.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "eslint": "^10.2.1",
    "nodemon": "^3.0.2"
  }
}
