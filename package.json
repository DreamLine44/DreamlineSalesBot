{
  "name": "dreamlinesalesbot",
  "version": "24.0.0",
  "description": "Multi-tenant AI WhatsApp Business SaaS Platform — v24.0.0 (greeting fix, date/time validation, full audit)",
  "main": "app.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node tests/nlp.test.mjs",
    "test:nlp": "node tests/nlp.test.mjs",
    "test:v18": "node tests/v18.test.mjs",
    "test:sim": "node tests/simulation.test.mjs",
    "seed": "node seed.js",
    "setup": "node scripts/setup.js",
    "gen-key": "node --input-type=module -e \"import {randomBytes} from 'crypto'; console.log(randomBytes(32).toString('hex'))\"",
    "fix-orders": "node scripts/fix-order-index.js",
    "fix-phonenumber-index": "node scripts/fix-phonenumberid-index.js",
    "migrate-apikey": "node scripts/migrate-apikey-hash.js",
