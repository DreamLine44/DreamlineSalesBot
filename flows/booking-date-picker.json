{
  "version": "7.2",
  "routing_model": {
    "BOOKING_DATE": []
  },
  "screens": [
    {
      "id": "BOOKING_DATE",
      "title": "Pick a date",
      "terminal": true,
      "success": true,
      "data": {
        "min_date": {
          "type": "string",
          "__example__": "2026-08-02"
        },
        "max_date": {
          "type": "string",
          "__example__": "2027-08-02"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "booking_date_form",
            "children": [
              {
                "type": "CalendarPicker",
                "name": "booking_date",
                "label": "Select your booking date",
                "mode": "single",
                "min-date": "${data.min_date}",
                "max-date": "${data.max_date}",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "booking_date": "${form.booking_date}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
